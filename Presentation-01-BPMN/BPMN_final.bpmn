      <bpmn:outgoing>Flow_SendGpsToWait</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_SendGps" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_Wait5s" name="Wait 5 seconds">
