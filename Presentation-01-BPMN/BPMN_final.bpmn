    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_DeliveryComplete" name="Delivery complete">
      <bpmn:incoming>Flow_ToDeliveryComplete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_DriverAssignedNotif" name="Assigned notification">
