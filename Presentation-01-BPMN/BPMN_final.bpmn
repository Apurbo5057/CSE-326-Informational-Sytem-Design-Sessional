    <bpmn:sequenceFlow id="Flow_ToMarkDeliveryComplete" sourceRef="Event_OtpVerified" targetRef="Task_MarkDeliveryComplete" />
    <bpmn:sequenceFlow id="Flow_ToSendDeliveryConfirmation" sourceRef="Task_MarkDeliveryComplete" targetRef="Event_SendDeliveryConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToDeliveryComplete" sourceRef="Event_SendDeliveryConfirmation" targetRef="EndEvent_DeliveryComplete" />
    <bpmn:intermediateThrowEvent id="Event_SendCodConfirmation" name="Send COD confirmation">
