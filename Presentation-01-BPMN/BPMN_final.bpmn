    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToVerification" sourceRef="EndEvent_HandoverComplete" targetRef="Task_AskReceiverOtp" />
    <bpmn:intermediateThrowEvent id="Event_SendGpsUpdate" name="Send location">
